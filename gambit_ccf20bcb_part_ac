1481709390628130856,1381987595881414656,ⴷ・ⴷffine・120,799672011265015819,319622787566141441,liffe3392,"tao_miner  [τ, τ]","Please use this script to check commit history of the hotkey. If the hotkey has a commit history, that hotkey is not usable. If the miner has so many clean hotkeys and contiues registration, we can suspect the spamming.

```
import asyncio, json, sys
sys.path.insert(0, '/workspace/affine-cortex') # # ← replace with affine directory
from affine.utils.subtensor import get_subtensor
from affine.core.setup import NETUID
HOTKEY = ""5ABCDEF.....""   # ← replace with full hotkey
async def main():
    sub = await get_subtensor()
    meta = await sub.metagraph(NETUID)
    commits = await sub.get_all_revealed_commitments(NETUID)
    history = commits.get(HOTKEY, [])
    if not history:
        print(""No commits found for this hotkey"")
        return
    print(f""Commit history for {HOTKEY[:12]}... ({len(history)} commits):\n"")
    for block, raw in history:
        data = json.loads(raw)
        print(f""  Block {block:>10} | model={data.get('model')} | revision={data.get('revision','')[:12]}..."")
asyncio.run(main())
```",2026-03-12T17:44:07.555000+00:00,,False,,False,0,0,0
