1475572944511045672,1387865673690251445,מ・basilica・39,799672011265015819,1020187154502144072,fivebytes,"Tegridy [τ, ك]","For example you could create: `sudo nano /etc/update-motd.d/90-nvidia-gpu` 

And use:

``` 
#!/bin/bash

# Check if nvidia-smi is available
if command -v nvidia-smi &> /dev/null
then
    echo ""------------------------------------------------------""
    # Extract GPU model (handles multiple GPUs by listing each one)
    echo ""NVIDIA GPUs:""
    nvidia-smi --query-gpu=name --format=csv,noheader | while read gpu_name; do
        echo ""  - $gpu_name""
    done

    # Extract CUDA version supported by the driver
    # nvidia-smi shows the *maximum* CUDA version supported by the current driver
    cuda_version=$(nvidia-smi | grep ""CUDA Version"" | awk '{print $NF}')
    echo ""CUDA Version (Driver): $cuda_version""

    # Extract CUDA toolkit version (if installed, different from driver version)
    if command -v nvcc &> /dev/null
    then
        nvcc_version=$(nvcc -V | grep ""release"" | awk '{print $5}' | cut -d',' -f1 | sed 's/V//')
        echo ""CUDA Toolkit Version (Installed): $nvcc_version""
    fi
    echo ""------------------------------------------------------""
fi
```",2026-02-23T19:20:04.791000+00:00,,False,,False,0,0,0
