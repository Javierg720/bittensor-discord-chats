    name: str = Field(""world"", max_length=64)


class HelloOut(BaseModel):
    message: str


@chute.cord(
    public_api_path=""/hello"",
    public_api_method=""POST"",
)
async def hello(self, input_args: HelloIn) -> HelloOut:
    return HelloOut(message=f""Hello, {input_args.name}!"")
